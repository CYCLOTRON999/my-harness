# OpenRouter API Key
OPENROUTER_API_KEY=sk-or-v1-...

# Default model (DeepSeek-V3 is fast and token-cheap at ~$0.14 / 1M tokens)
OPENROUTER_MODEL=deepseek/deepseek-chat

# Fallback Gemini API Key (activates automatically on rate limit or 429)
GEMINI_API_KEY=AQ.Ab8...
GEMINI_MODEL=gemini-3.5-flash-lite
